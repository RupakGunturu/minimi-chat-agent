{
  "name": "minimi",
  "description": "Time-aware chat assistant with dated memory and claim re-verification.",
  "repository": "https://github.com/RupakGunturu/minimi-chat-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "check:client": "node --check public/app.js",
    "test": "node --import tsx --test tests/api.test.ts tests/core.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts tests/core.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:client && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "openai": "^6.49.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
