# Required
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
TAVILY_API_KEY=            # https://app.tavily.com

# Optional
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_MAIN=gemini-3.5-flash-lite        # answers + tool use
MODEL_FAST=gemini-3.5-flash-lite   # claim extraction + eval judge (off the hot path)
DEFAULT_TZ=                        # IANA zone, e.g. Asia/Kolkata (browser tz is used when available)
NOW_OVERRIDE=                      # ISO timestamp to fake the clock, e.g. 2026-11-11T09:00:00Z
PORT=3000
