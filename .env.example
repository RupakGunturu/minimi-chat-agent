# --- Required API keys -------------------------------------------------------
# Model access. Any OpenAI-compatible provider works; the default is Gemini.
# Use GEMINI_API_KEY or LLM_API_KEY (an alias, useful for non-Gemini providers).
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
TAVILY_API_KEY=            # https://app.tavily.com

# --- Optional: model --------------------------------------------------------
LLM_API_KEY=               # alias for GEMINI_API_KEY when LLM_BASE_URL is not Google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_MAIN=gemini-3.5-flash-lite    # answers + tool use
MODEL_FAST=gemini-3.5-flash-lite    # claim extraction + eval judge (off the hot path)

# --- Optional: time and server ----------------------------------------------
DEFAULT_TZ=                # IANA zone, e.g. Asia/Kolkata (browser tz is used when available)
NOW_OVERRIDE=              # ISO timestamp to fake the clock, e.g. 2026-11-11T09:00:00Z
PORT=3000
AUTH_HEADER=x-user-id      # request header used as the single-user seam
DATA_FILE=data/store.json  # runtime store (git-ignored)

# --- Optional: search quality ------------------------------------------------
SEARCH_DEPTH=advanced      # advanced reads more of each source; basic is the fallback
SEARCH_RESULTS=8           # results requested per query (agent shows the best of these)
READ_PAGES=true            # fetch the top primary-looking pages for cleaner excerpts
READ_PAGES_PER_QUERY=1     # page fetches per search query (0 disables)
READ_CHARS=600             # excerpt cap per result sent to the model
SEARCH_TIMEOUT_MS=12000
FETCH_TIMEOUT_MS=6000
MAX_PAGE_BYTES=524288      # never read more than 512 KB from a page
VERDICT_GUARD=true         # downgrade when the cited source lacks the entity or is only secondary

# --- Optional: limits -------------------------------------------------------
MAX_BODY_BYTES=32768       # request body cap
MAX_MESSAGE_CHARS=4000     # user message cap
MAX_TURNS_PER_CONV=200     # turns per conversation before starting a new chat
CHAT_RATE_LIMIT=12         # /api/chat requests per window per user+ip
CHAT_RATE_WINDOW_MS=60000
API_RATE_LIMIT=120         # all /api requests per window per user+ip
API_RATE_WINDOW_MS=60000
